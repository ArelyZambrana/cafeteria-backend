# Copia este archivo a ".env" y ajusta los valores. NUNCA subas el .env real.

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafeteria

# Servidor de la API
HOST=127.0.0.1
PORT=3000

# Orígenes del frontend permitidos por CORS (separados por comas)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Ollama local (chatbot)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
